{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/frederikgeth/BMOPFDraftData/docs/tags_schema.json",
  "title": "BMOPF benchmark feature-tag index",
  "description": "Derived feature tags for BMOPF benchmark cases. See docs/TAGGING.md for the controlled vocabulary and derivation rules. Records are generated by scripts/tag_cases.jl and MUST NOT be hand-edited.",
  "type": "object",
  "required": ["vocabulary_version", "generated_at", "cases"],
  "additionalProperties": false,
  "properties": {
    "vocabulary_version": {
      "type": "string",
      "description": "SemVer of the tagging vocabulary in docs/TAGGING.md."
    },
    "generated_at": {
      "type": "string",
      "description": "ISO-8601 timestamp of the tagging run."
    },
    "tool": {
      "type": "string",
      "description": "Generator provenance, e.g. 'scripts/tag_cases.jl + BMOPFTools.jl vX.Y'."
    },
    "cases": {
      "type": "array",
      "items": { "$ref": "#/definitions/case" }
    }
  },
  "definitions": {
    "case": {
      "type": "object",
      "required": [
        "id", "path", "dataset", "model_tier", "benchmark_class", "challenge",
        "provenance", "structure", "wires_grounding", "components",
        "load_der", "task", "driving_findings"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "description": "Case stem, e.g. Network_8_Feeder_1." },
        "path": { "type": "string", "description": "Repo-relative path to the case JSON." },
        "dataset": { "type": "string", "description": "Dataset family, e.g. ENWLbenchmark, ENWLsnapshots." },
        "report": { "type": ["string", "null"], "description": "Repo-relative path to the _report.md." },
        "tree": { "type": ["string", "null"], "description": "Repo-relative path to the _tree.txt." },
        "solution": { "type": ["string", "null"], "description": "Repo-relative path to a solution/result artifact, if any." },

        "model_tier": { "enum": ["T1", "T2", "T3", "Tinf"] },
        "benchmark_class": {
          "enum": ["core", "watch", "pathological"],
          "description": "Well-posedness gate. 'core' = clean, solved, genuinely binding, strictly complementary real-world case (the recommended set). 'watch' = usable but with a data-quality caveat (symmetry/ambiguity/conditioning, or nothing binds). 'pathological' = known degeneracy (rank deficiency, sequence-derived symmetry) or the reference solver fails."
        },
        "challenge": {
          "enum": ["C1", "C2", "C3", null],
          "description": "Genuine computational load among cases, from the solution profile (degrees of freedom). C1 <200, C2 200-2000, C3 >=2000. null when no solved profile is available. NOT a pathology score."
        },

        "provenance": {
          "type": "object",
          "required": ["source", "license", "commercial_use"],
          "additionalProperties": false,
          "properties": {
            "source": { "type": "string" },
            "doi": { "type": ["string", "null"] },
            "license": { "enum": ["CC-BY-4.0", "CC-BY-NC-SA-4.0"] },
            "commercial_use": { "type": "boolean" }
          }
        },

        "structure": {
          "type": "object",
          "required": ["topology", "size_class", "n_buses", "n_voltage_levels", "multi_voltage_level"],
          "additionalProperties": false,
          "properties": {
            "topology": { "enum": ["radial", "meshed"] },
            "size_class": { "enum": ["xs", "s", "m", "l", "xl"] },
            "n_buses": { "type": "integer", "minimum": 0 },
            "n_voltage_levels": { "type": "integer", "minimum": 0 },
            "multi_voltage_level": { "type": "boolean" },
            "parallel_lines": { "type": "boolean" }
          }
        },

        "wires_grounding": {
          "type": "object",
          "required": ["wires", "neutral_model"],
          "additionalProperties": false,
          "properties": {
            "wires": {
              "type": "array",
              "items": { "type": "integer", "minimum": 1, "maximum": 4 },
              "uniqueItems": true
            },
            "neutral_model": {
              "type": "array",
              "items": { "enum": ["explicit_neutral", "kron_reduced", "phase_to_neutral", "modified_pn"] },
              "uniqueItems": true
            },
            "grounding": { "enum": ["perfect", "impedance", "multi_point", "unknown"] },
            "swer_zone": { "type": "boolean" },
            "split_phase_zone": { "type": "boolean" }
          }
        },

        "components": {
          "type": "array",
          "description": "Component types present (inventory total > 0).",
          "items": {
            "enum": ["transformer", "switch", "shunt", "inverter", "control_profile", "storage", "generator"]
          },
          "uniqueItems": true
        },
        "transformer_vector_groups": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },

        "load_der": {
          "type": "object",
          "required": ["load_models", "load_configs", "der_penetration"],
          "additionalProperties": false,
          "properties": {
            "load_models": {
              "type": "array",
              "items": { "enum": ["constant_power", "constant_current", "constant_impedance", "zip", "exponential"] },
              "uniqueItems": true
            },
            "load_configs": {
              "type": "array",
              "items": { "enum": ["WYE", "DELTA", "SINGLE_PHASE"] },
              "uniqueItems": true
            },
            "der_penetration": { "enum": ["none", "low", "moderate", "high"] },
            "ibr_prime_movers": {
              "type": "array",
              "items": { "type": "string" },
              "uniqueItems": true
            }
          }
        },

        "task": {
          "type": "array",
          "items": { "enum": ["gen_cost_min", "export_max", "switching", "state_estimation", "curtailment_min", "power_flow"] },
          "uniqueItems": true
        },

        "solvability": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "solved": { "type": ["boolean", "null"] },
            "si_pu_agree": { "type": ["boolean", "null"] },
            "objective_well_posed": { "type": ["boolean", "null"] },
            "only_slack_generation": { "type": ["boolean", "null"] },
            "needs_augmentation": { "type": ["boolean", "null"] }
          }
        },

        "solution_profile": {
          "type": ["object", "null"],
          "description": "Optimization fingerprint of the best-known (per-unit) solution, from BMOPFTools' solver profiler. null when the case has no persisted solve.",
          "additionalProperties": false,
          "properties": {
            "status": { "type": ["string", "null"] },
            "dof": { "type": ["integer", "null"], "description": "Degrees of freedom = n_variables - n_equality_constraints." },
            "n_variables": { "type": ["integer", "null"] },
            "n_eq": { "type": ["integer", "null"] },
            "n_ineq": { "type": ["integer", "null"] },
            "n_active": { "type": ["integer", "null"], "description": "Inequality constraints binding at the optimum." },
            "is_opf": { "type": ["boolean", "null"], "description": "At least one operational constraint binds (else effectively a power-flow instance)." },
            "strict_complementarity": { "type": ["boolean", "null"] },
            "n_weakly_active": { "type": ["integer", "null"], "description": "Binding constraints with ~zero multiplier (degeneracies)." },
            "max_shadow_price": { "type": ["number", "null"] },
            "barrier_iterations": { "type": ["integer", "null"] },
            "solve_time_s": { "type": ["number", "null"], "description": "Solver time (not wall-clock)." },
            "loss_fraction": { "type": ["number", "null"] }
          }
        },

        "driving_findings": {
          "type": "array",
          "description": "Finding codes / signals that drove benchmark_class, for explainability.",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "finding_counts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "errors": { "type": "integer", "minimum": 0 },
            "warnings": { "type": "integer", "minimum": 0 },
            "info": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}
